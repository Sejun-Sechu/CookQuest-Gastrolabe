# Independent server-only credentials. Never commit real keys.
FRIDGE_GEMINI_API_KEY=
FRIDGE_GEMINI_MODEL=gemini-3.5-flash-lite
FRIDGE_GEMINI_FREE_TIER_CONFIRMED=false
FRIDGE_GEMINI_TRUST_ENV=false
# Shared recipe/map database. Legacy COOKING_DATABASE_PATH is also supported.
COOKQUEST_DATABASE_PATH=data/cooking.db
# Disable reusable AI/discovery/HTTP caches; recipe records and sessions remain.
COOKQUEST_CACHE_ENABLED=false

# Gastrolabe Gateway / Empathy Bridge (server only; no key in the map HTML).
GASTROLABE_GEMINI_API_KEY=
GASTROLABE_GEMINI_MODEL=gemini-3.5-flash-lite
GASTROLABE_GEMINI_FREE_TIER_CONFIRMED=false
# Explicit opt-in only: use the existing fridge key + its Free Tier confirmation
# if no separate Gastrolabe key is configured. Legacy cooking credentials are unused.
GASTROLABE_USE_FRIDGE_KEY=false

# Optional recipe illustration lookup (TheMealDB).
MEALDB_ENABLED=1
